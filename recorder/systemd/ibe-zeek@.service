[Unit]
Description=IBE recorder: Zeek on %i (raw logs in RAM only)
After=network.target local-fs.target
# capture only when the key stick is present, recording is armed and the limit is not reached
ConditionPathExists=/mnt/ibe-key/hmac.key
ConditionPathExists=/mnt/ibe-key/armed.json
ConditionPathExists=!/var/lib/ibe/STOP

[Service]
Type=simple
Environment=PYTHONPATH=/opt/ibe
# the same checks again, plus the clock. Exit status 3 means: not allowed, do not retry
ExecStartPre=/usr/bin/python3 -m ibe_recorder --config /etc/ibe/config.json preflight
ExecStartPre=/usr/bin/mkdir -p /run/ibe/raw/%i
# nothing may leave through a capture interface: load the drop rule first, then bring the link up
ExecStartPre=/usr/sbin/nft -f /etc/ibe/egress-%i.nft
ExecStartPre=/usr/sbin/ip link set %i up promisc on arp off
ExecStartPre=-/usr/sbin/ethtool -K %i rx off tx off sg off tso off gso off gro off lro off rxvlan off txvlan off
WorkingDirectory=/run/ibe/raw/%i
ExecStart=/opt/zeek/bin/zeek -b -C -i %i /opt/ibe/zeek/ibe.zeek
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=3
Nice=-5

[Install]
WantedBy=multi-user.target
